# ===================== Unity / 团结引擎 生成目录 =====================
/[Ll]ibrary/
/[Tt]emp/
[Oo]bj/
[Bb]in/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 通过 UnityX 导入的资源（自动生成）
/[Aa]ssets/AssetStoreTools*

# 自动生成的解决方案与工程文件
/*.csproj
/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vsconfig

# ===================== 工具链 / 版本控制残留 =====================
# Plastic SCM（团结内置）
.plastic/
ignore.conf

# 团结 AI 桥接
.codely-cli/
.codely.packages/
.codelyignore

# WorkBuddy 项目记忆
.workbuddy/

# ===================== 构建产物 =====================
*.apk
# 例外：仓库里的 release/ 目录就是发包目录，APK 要入库（用户要求）
!release/*.apk
*.aab
*.unitypackage
*.app
/[Ee]xported[Oo]bj/
# 本地出包目录（与 /Builds/ 同性质；只忽略根目录这一层）
/[Oo]ut[Pp]ut/
crashlytics-build.properties

# ===================== 操作系统 =====================
.DS_Store
Thumbs.db
desktop.ini

# 编辑器截图/录像（验证用，不入库）
/screenshots/

# ===================== 保留 =====================
# Assets 下的 .meta 必须纳入版本控制
!/[Aa]ssets/**/*.meta

# 本地启动脚本
/启动编辑器.bat

# Python 缓存（Tools/ 下的预览与生成脚本）
__pycache__/
*.pyc

# ===================== 凭据（绝不入库）=====================
# 发布 GitHub Release 用的 fine-grained PAT，由 Tools/publish_release.py 读取
/.github_token
*.token
